# AI (ixtiyoriy). Kalit yo'q bo'lsa AI o'chiq turadi va ilova qoidaviy rejimda ishlaydi.
# Bu faylni .env ga nusxalab, kalitni FAQAT shu yerga yozing. .env git'ga qo'shilmaydi. Kalitni hech qachon chatga yozmang.

# anthropic | openai | gemini   (openai: OpenAI-mos istalgan xizmat, masalan Groq/OpenRouter, AI_BASE_URL bilan)
AI_PROVIDER=
AI_API_KEY=
# anthropic uchun standart: claude-haiku-5-5. openai va gemini uchun model nomini o'zingiz yozing.
AI_MODEL=
# Ixtiyoriy: boshqa manzil (masalan https://api.groq.com/openai  yoki OpenRouter)
AI_BASE_URL=
# Boshqa provayderdagi zaxira (ixtiyoriy, tavsiya etiladi): asosiy provayder band bo'lsa (masalan Gemini 503) yoki kaliti/mablag'i tugasa
# shu provayderga o'tiladi. Masalan: AI_BACKUP_PROVIDER=anthropic, AI_BACKUP_MODEL=claude-haiku-5-5
AI_BACKUP_PROVIDER=
AI_BACKUP_API_KEY=
AI_BACKUP_MODEL=
AI_BACKUP_BASE_URL=
# Bir foydalanuvchiga kuniga AI so'rovlar soni
AI_DAILY_LIMIT=120

# O'zbekcha neyron ovoz (ixtiyoriy, Azure Speech). Kalit yo'q bo'lsa ustoz o'zbekcha reaksiyani brauzer ovozida (bo'lsa) yoki inglizcha aytadi.
# Ovoz nomlari Azure ro'yxatida tekshiring: uz-UZ-MadinaNeural (ayol), uz-UZ-SardorNeural (erkak)
TTS_KEY=
TTS_REGION=
TTS_VOICE=uz-UZ-MadinaNeural
TTS_DAILY_LIMIT=400

# To'lov (Hamyon, kartaga o'tkazma). Kalit yo'q bo'lsa demo rejim ishlaydi (obuna to'lovsiz, faqat shu qurilmada).
# Hamyon botida: prepare_url = https://<domen>/api/pay/hamyon/prepare, complete_url = https://<domen>/api/pay/hamyon/complete
HAMYON_SHOP_ID=
HAMYON_SHOP_KEY=
# Narxlar (so'm / 1 oy). Bo'sh qoldirilsa src/config.ts dagi namunaviy narx ishlatiladi.
PRICE_EXAM=
PRICE_GRAMMAR=
PRICE_MOCKS=
# Referal: taklif qilingan do'st birinchi darsni o'tasa ikkalasiga REF_XP (standart 100). Ixtiyoriy pulga teng mukofot:
# REF_PLAN_DAYS (0 — o'chiq, eng ko'pi 30) kun All Access ikkalasiga; taklif qilgan 30 kunda ko'pi bilan REF_PLAN_MONTHLY_CAP marta oladi.
REF_PLAN_DAYS=
REF_PLAN_MONTHLY_CAP=3
# Tashqi zaxira (tavsiya etiladi): kunlik nusxa S3-mos omborga ham yuboriladi (Railway Bucket, R2, S3). Bo'sh — o'chiq.
# Batafsil: docs/runbooks/backup-restore.md "Off-site copy"
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
# Qo'llab-quvvatlash: to'lov ro'yxati va qo'lda obuna berish (x-admin sarlavhasi). Bo'sh bo'lsa o'chiq.
ADMIN_TOKEN=
# Google bilan kirish (ixtiyoriy). Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application):
# "Authorized JavaScript origins" ga https://sellzen.uz qo'shing. Bu yerga faqat Client ID (maxfiy emas) yoziladi; bo'sh bo'lsa Google tugmasi chiqmaydi.
GOOGLE_CLIENT_ID=
# Telegram: foydalanuvchilar kiradigan asosiy manzil. Telegram kirish tugmasi faqat BotFather'dagi domen (/setdomain) bilan bir xil manzilda ishlaydi —
# PUBLIC_URL va /setdomain bir xil bo'lsin (hozir: https://sellzen.uz va sellzen.uz; DNS Cloudflare'da, SSL/TLS = Full). Domen HTTPS sertifikatiga ega bo'lishi shart.
PUBLIC_URL=

# Telegram aloqa xabarlari: Telegram'ga ulangan o'quvchiga kamida 2–3 kunda bitta qisqa xabar (18:00–21:00 Toshkent).
# Sukut bo'yicha YOQILGAN; o'chirish uchun TG_NUDGES=0. O'quvchi /stop bilan to'xtatadi. Seriya eslatmalari (TG_REMINDERS=1) bilan birga ishlaydi.
TG_NUDGES=

# --- O'z karta-to'lov moduli (Hamyon'siz) — docs/OWN_CARD_PAYMENTS.md ---
# off (standart) | capture (xabarlarni yozib oladi) | shadow (solishtiradi, obuna bermaydi) | live (yangi to'lovlar bizning kartaga)
PAY_OWN_MODE=off
# Foydalanuvchiga ko'rsatiladigan karta raqami (live uchun majburiy)
PAY_OWN_CARD=
# To'lov oynasi (daqiqa, standart 15) va kech kelgan to'lov uchun qo'shimcha muddat (daqiqa, standart 180)
PAY_OWN_WINDOW_MIN=15
PAY_OWN_GRACE_MIN=180
# Kartalar va rejim admin panelda ham boshqariladi (u ustun). spread | fill; limit zaxirasi %
PAY_OWN_STRATEGY=spread
PAY_OWN_RESERVE_PCT=10
# Karta-xabarlari botlari (vergul bilan)
TG_NOTICE_SOURCES=CardXabarBot,HUMOcardbot
# Telegram (my.telegram.org) va sessiya (npm run pay:login). MAXFIY: faqat Railway Variables'da.
TG_API_ID=
TG_API_HASH=
TG_SESSION=
